{
  "name": "hybrid-hearts-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static bilingual (Arabic/English) website for Dr. Gamal Mansour — Hybrid Hearts Cardiac Surgery.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/cms-pull.mjs && next build && node scripts/fix-export-segments.mjs",
    "preview": "node scripts/serve-out.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:db && npm run cms:verify && npm run build",
    "cms:pull": "node scripts/cms-pull.mjs",
    "cms:seed-sql": "tsx scripts/cms-seed-sql.ts",
    "cms:inventory": "tsx scripts/cms-inventory.ts",
    "cms:verify": "tsx scripts/cms-verify.ts",
    "test:db": "node scripts/test-cms-db.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "^16.35.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
