# =============================================================================
#  Hybrid Hearts — environment variables
#  Copy to .env.local for local development (never commit .env.local).
#  On your host (Vercel, Netlify, Cloudflare Pages, …) set the same names in the
#  project's environment-variable settings for the BUILD step.
#
#  Every variable below is PUBLIC: NEXT_PUBLIC_* values are embedded in the
#  website's JavaScript. Do NOT put the Supabase service-role / secret key, a
#  database password or any other secret in this file — the build refuses keys
#  that look privileged (scripts/supabase-key-guard.mjs).
#
#  With no Supabase values the site builds from the bundled content and the
#  dashboard (/admin) runs as a clearly labelled local sandbox.
# =============================================================================

# Public address of the website (canonical URLs, sitemap, Open Graph, auth emails).
# Example: https://www.example.com — no trailing slash.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (enables the CMS) ----------------------------------------------
# Supabase dashboard › Project Settings › API (or "Connect"):
#   Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key (starts with sb_publishable_…). Safe in the browser:
# every table and the media bucket are protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Older projects only: the legacy "anon" JWT key, if you have no publishable key.
# Leave empty when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Media library (optional) --------------------------------------------------
# Storage bucket created by the migration. Change only if you renamed it.
NEXT_PUBLIC_CMS_MEDIA_BUCKET=cms-media

# Upload size limits in MB, checked in the browser before uploading. The bucket
# itself allows at most 50 MB per file (see the migration); keep these at or below it.
NEXT_PUBLIC_CMS_MAX_IMAGE_MB=10
NEXT_PUBLIC_CMS_MAX_VIDEO_MB=50

# --- Build-time content pull (not public; read only by scripts/cms-pull.mjs) ---
# auto     (default) pull published content from Supabase when configured;
#          the build stops if the pull fails, so an outdated site is never deployed
# required fail the build when Supabase is not configured
# off      build from the bundled content (and content/published.json)
CMS_PULL=auto

# `npm run dev` checks for newly published content this often (seconds), so the
# local site updates without a rebuild.
CMS_DEV_POLL_SECONDS=5
